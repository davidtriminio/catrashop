# ---------------------------------------------------------------------------
# CommerceHub example environment. Copy to `.env` and fill in for local dev.
# NEVER commit a real `.env`. No production secrets belong in this repo.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=commercehub
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=commercehub
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=commercehub
RABBITMQ_PASSWORD=change_me_locally
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- n8n ---
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_locally

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080

# --- Auth (JWT) --- generate strong values locally; do NOT reuse these
JWT_ISSUER=commercehub
JWT_AUDIENCE=commercehub-clients
JWT_SIGNING_KEY=replace_with_a_long_random_dev_only_key_min_32_chars

# --- AI (LLM provider) --- leave blank to use the deterministic fake provider
LLM_PROVIDER=fake
LLM_API_KEY=

# --- Local dev only: also set the API secrets via `dotnet user-secrets` (see docs/deployment.md) ---
