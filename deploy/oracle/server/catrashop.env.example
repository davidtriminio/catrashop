# /etc/catrashop/catrashop.env  (chmod 640 root:catrashop; NEVER commit the real one)
# Generate each secret with:  openssl rand -hex 32
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080

ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=catrashop;Username=catrashop;Password=CHANGE_ME_HEX
# Same database in URL form, used only by migrate.sh (psql)
DATABASE_URL=postgresql://catrashop:CHANGE_ME_HEX@127.0.0.1:5432/catrashop

Identity__Jwt__Issuer=catrashop
Identity__Jwt__Audience=catrashop-clients
Identity__Jwt__SigningKey=CHANGE_ME_HEX
Payments__WebhookSecret=CHANGE_ME_HEX

# 1 GB VM: no RabbitMQ. Events are dispatched in-process (the Outbox still guarantees delivery).
Messaging__Transport=InProcess

# Browser origins allowed to call the API (your Vercel apps). The mobile app does not use CORS.
Security__Cors__AllowedOrigins__0=https://shop.davidtriminio.dev
Security__Cors__AllowedOrigins__1=https://admin.davidtriminio.dev
AllowedHosts=api.davidtriminio.dev

# Memory caps for a 1 GB machine
DOTNET_gcServer=0
DOTNET_GCHeapHardLimit=0x16000000
DOTNET_TieredPGO=0
