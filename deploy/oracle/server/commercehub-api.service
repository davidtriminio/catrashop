[Unit]
Description=CommerceHub API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=commercehub
Group=commercehub
WorkingDirectory=/opt/commercehub/current
EnvironmentFile=/etc/commercehub/commercehub.env
ExecStart=/usr/bin/dotnet /opt/commercehub/current/CommerceHub.Api.dll
Restart=always
RestartSec=5
# Keep one process from taking down the 1 GB host
MemoryHigh=380M
MemoryMax=450M
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/commercehub

[Install]
WantedBy=multi-user.target
