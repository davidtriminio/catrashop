{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Security": {
    "//": "Phase 20 hardening. AllowedOrigins lists the local SPAs (customer :4200, admin :4300). Empty = same-origin only.",
    "Cors": {
      "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4300" ]
    },
    "RateLimiting": {
      "Enabled": true,
      "PermitPerWindow": 600,
      "WindowSeconds": 60,
      "AuthPermitPerWindow": 30,
      "QueueLimit": 0
    },
    "EnableHttpsRedirection": false
  },
  "Observability": {
    "ServiceName": "commercehub-api",
    "//OtlpEndpoint": "Set to http://localhost:4317 to export traces/metrics/logs to the compose 'observability' profile (Jaeger). Empty disables OTLP export.",
    "OtlpEndpoint": "",
    "ConsoleExporter": false,
    "PrometheusEndpoint": true
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=commercehub;Username=commercehub;Password=commercehub"
  },
  "Identity": {
    "Jwt": {
      "Issuer": "commercehub",
      "Audience": "commercehub-clients",
      "//SigningKey": "DEVELOPMENT ONLY. Override in production via env var Identity__Jwt__SigningKey. Never use this value outside local dev.",
      "SigningKey": "dev-only-signing-key-change-me-please-32+chars-minimum-abcdef",
      "AccessTokenMinutes": 15
    },
    "Security": {
      "RefreshTokenDays": 14,
      "PasswordResetTokenHours": 2
    }
  },
  "Orders": {
    "TaxRatePercent": 10,
    "ReservationHoldMinutes": 30
  },
  "Payments": {
    "Provider": "fake",
    "//WebhookSecret": "DEVELOPMENT ONLY. Override in production via env var Payments__WebhookSecret.",
    "WebhookSecret": "dev-only-webhook-secret-change-me"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "commercehub",
    "//Password": "DEVELOPMENT ONLY. Matches docker-compose default; override in production via env var RabbitMq__Password.",
    "Password": "commercehub",
    "VirtualHost": "/",
    "Exchange": "commercehub.events",
    "QueueName": "commercehub.consumers",
    "PublishIntervalSeconds": 5,
    "PublishBatchSize": 100
  }
}
