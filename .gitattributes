# Normalize line endings: repo stores LF; Windows checkouts get CRLF for native files.
* text=auto

# Explicitly LF for cross-platform tooling / scripts
*.sh    text eol=lf
*.cs    text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-native
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.pfx binary

*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
